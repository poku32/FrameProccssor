<Window x:Class="FrameProccssor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FrameProccssor"
        xmlns:vm="clr-namespace:FrameProccssor.ViewModels"
        xmlns:cv="clr-namespace:FrameProccssor.Converters"
        mc:Ignorable="d"
        Title="帧处理工具 — 长帧定位与解析"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        MinHeight="400" MinWidth="800" MaxHeight="900" MaxWidth="1200"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <cv:SizeKindConverter x:Key="SizeKindCvt"/>
        <cv:BoolInverterConverter x:Key="BoolInvert"/>
        <cv:StringToVisibilityConverter x:Key="StringToVis"/>
        <cv:IndexHighlightConverter x:Key="IndexHighlight"/>

        <!-- 字节格的背景色 -->
        <SolidColorBrush x:Key="ByteCellBg" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="ByteCellHighlightBg" Color="#FFD700"/>
        <SolidColorBrush x:Key="ByteCellFieldBg0" Color="#E8F5E9"/>
        <SolidColorBrush x:Key="ByteCellFieldBg1" Color="#E3F2FD"/>

        <!-- 字节格模板 -->
        <DataTemplate x:Key="ByteCellTemplate">
            <Border x:Name="cellBorder"
                    Width="44" Height="52" Margin="1"
                    BorderBrush="#CCCCCC" BorderThickness="1"
                    CornerRadius="3" Background="#F0F0F0"
                    ToolTip="{Binding}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding HexDisplay}"
                               FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Index}"
                               FontSize="10" Foreground="#888888"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter TargetName="cellBorder" Property="Background" Value="#FFD700"/>
                    <Setter TargetName="cellBorder" Property="BorderBrush" Value="#FF8C00"/>
                    <Setter TargetName="cellBorder" Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 字段分组条模板 -->
        <DataTemplate x:Key="FieldGroupTemplate">
            <Border Height="26" Margin="1,0" CornerRadius="3"
                    ToolTip="{Binding Field.Name}"
                    Background="{Binding DisplayColor}">
                <TextBlock Text="{Binding Field.Name}"
                           FontSize="10" Foreground="#333"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="4,0"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- 主布局 -->
    <DockPanel Margin="8">
        <!-- 底部状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding TemplateName}" Foreground="#888"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 字段定义 -->
                <RowDefinition Height="Auto"/>   <!-- 帧数据 + 定位 -->
                <RowDefinition Height="*"/>      <!-- 字节布局 + 选区解析（并排） -->
            </Grid.RowDefinitions>

            <!-- ======== 一、字段定义区 ======== -->
            <GroupBox Grid.Row="0" Header="帧结构定义" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="FieldsGrid" ItemsSource="{Binding Fields}"
                              SelectedItem="{Binding SelectedField}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              RowHeight="28" MaxHeight="200"
                              AllowDrop="True"
                              DragOver="DataGrid_DragOver"
                              Drop="DataGrid_Drop"
                              DragLeave="DataGrid_DragLeave"
                              Margin="0,0,0,6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="字段名" Binding="{Binding Name}" Width="120"/>
                            <DataGridTemplateColumn Header="大小类型" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeKind, Converter={StaticResource SizeKindCvt}}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding SizeKind, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.SizeKinds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Key"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="固定大小" Binding="{Binding FixedSize}" Width="70"/>
                            <DataGridTemplateColumn Header="依赖字段" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DependsOn}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox Text="{Binding DependsOn, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  ItemsSource="{Binding DataContext.DependencySourceFields, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="倍率" Binding="{Binding Multiplier}" Width="60"/>
                            <DataGridTextColumn Header="偏移" Binding="{Binding Offset}" Width="60"/>
                            <DataGridTextColumn Header="计算结果" Binding="{Binding SizeDisplay}"
                                                Width="Auto" IsReadOnly="True"/>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Width="24" Height="22"
                                                FontSize="11" Foreground="Red"
                                                Command="{Binding DataContext.DeleteFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="＋ 添加字段" Command="{Binding AddFieldCommand}"
                                Width="90" Height="26" Margin="0,0,8,0"/>
                        <Button Content="保存模板" Command="{Binding SaveTemplateCommand}"
                                Width="80" Height="26" Margin="0,0,4,0"/>
                        <Button Content="加载模板" Command="{Binding LoadTemplateCommand}"
                                Width="80" Height="26"/>
                        <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11" TextWrapping="Wrap">
                            <Run Text="固定" Foreground="#1976D2" FontWeight="Bold"/>
                            <Run Text="= 固定字节数   " Foreground="#666"/>
                            <Run Text="依赖" Foreground="#388E3C" FontWeight="Bold"/>
                            <Run Text="= 大小=依赖字段值×倍率+偏移   " Foreground="#666"/>
                            <Run Text="剩余" Foreground="#F57C00" FontWeight="Bold"/>
                            <Run Text="= 前面分完剩下的全归它   " Foreground="#666"/>
                            <Run Text="尾部固定" Foreground="#C62828" FontWeight="Bold"/>
                            <Run Text="= 从帧尾倒数固定字节" Foreground="#666"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- ======== 二、帧数据 + 定位 ======== -->
            <GroupBox Grid.Row="1" Header="帧数据 &amp; 定位" Margin="0,0,0,6">
                <StackPanel>
                    <!-- Hex 输入 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding HexString, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="13"
                                 MinHeight="50" MaxHeight="80"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="粘贴十六进制数据，支持空格、换行、0x前缀等分隔方式。"/>
                        <Button Grid.Column="1" Content="解析" Width="70" Margin="8,0,0,0"
                                Command="{Binding ParseCommand}"
                                VerticalAlignment="Top" Height="50"
                                FontWeight="Bold" FontSize="14"/>
                    </Grid>

                    <!-- 定位栏 -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="字节索引:" VerticalAlignment="Center" Margin="0,0,6,0"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="IndexInputBox"
                                 Text="{Binding IndexInput, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80" FontFamily="Consolas" FontSize="14"
                                 VerticalContentAlignment="Center"
                                 TextChanged="IndexTextBox_TextChanged"/>
                        <Button Content="🔍 定位" Command="{Binding LocateCommand}"
                                Width="80" Height="26" Margin="8,0,0,0"/>
                        <TextBlock VerticalAlignment="Center" Margin="12,0,4,0"
                                   Foreground="#888" FontSize="11"
                                   Text="Shift+点击字节 = 扩展选区"/>
                        <Button Content="✕ 清除选区" Width="80" Height="26"
                                Click="ClearSelection_Click"/>
                    </StackPanel>

                    <!-- 定位结果 -->
                    <Border Background="#FFFFF9C4" CornerRadius="3"
                            Padding="8,4" MinHeight="28" Margin="0,4,0,0"
                            Visibility="{Binding LocateResult, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="{Binding LocateResult}"
                                   FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </GroupBox>

            <!-- ======== 三、字节布局 + 选区解析（并排） ======== -->
            <Grid Grid.Row="2" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="320" MinWidth="280"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：字节布局 -->
                <GroupBox Grid.Column="0" Header="字节布局"
                          PreviewMouseLeftButtonDown="ByteLayout_PreviewMouseLeftButtonDown">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HexRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="50" Height="40" Margin="1"
                                                Background="#EEEEEE" CornerRadius="2">
                                            <TextBlock Text="{Binding Address}"
                                                       FontFamily="Consolas" FontSize="12"
                                                       FontWeight="Bold" Foreground="#666666"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="cellBorder"
                                                            Width="42" Height="40" Margin="1"
                                                            BorderBrush="#CCCCCC" BorderThickness="1"
                                                            CornerRadius="2" Background="#F5F5F5"
                                                            Cursor="Hand"
                                                            MouseLeftButtonDown="ByteCell_Click"
                                                            MouseEnter="ByteCell_MouseEnter"
                                                            MouseRightButtonDown="ByteCell_RightClick">
                                                        <Border.ContextMenu>
                                                            <ContextMenu x:Name="FieldContextMenu" Opened="FieldContextMenu_Opened"/>
                                                        </Border.ContextMenu>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding HexDisplay}"
                                                                       FontFamily="Consolas" FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Index}"
                                                                       FontSize="9" Foreground="#999999"
                                                                       HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="cellBorder" Property="Background" Value="#FFB74D"/>
                                                            <Setter TargetName="cellBorder" Property="BorderBrush" Value="#E65100"/>
                                                            <Setter TargetName="cellBorder" Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                            <Setter TargetName="cellBorder" Property="Background" Value="#FFD700"/>
                                                            <Setter TargetName="cellBorder" Property="BorderBrush" Value="#FF8C00"/>
                                                            <Setter TargetName="cellBorder" Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FieldColorIndex}" Value="1">
                                                            <Setter TargetName="cellBorder" Property="Background" Value="#E3F2FD"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FieldColorIndex}" Value="2">
                                                            <Setter TargetName="cellBorder" Property="Background" Value="#FFF3E0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FieldColorIndex}" Value="3">
                                                            <Setter TargetName="cellBorder" Property="Background" Value="#F3E5F5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FieldColorIndex}" Value="4">
                                                            <Setter TargetName="cellBorder" Property="Background" Value="#E0F7FA"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FieldColorIndex}" Value="5">
                                                            <Setter TargetName="cellBorder" Property="Background" Value="#FFF9C4"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>

                <!-- 分隔线 -->
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" Background="#DDD"/>

                <!-- 右侧：选区解析 -->
                <GroupBox Grid.Column="2" Header="选区解析">
                    <Grid>
                        <!-- 有选区时 -->
                        <Grid Visibility="{Binding SelectedInfo, Converter={StaticResource StringToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#FFF3E0" CornerRadius="3" Padding="6,4">
                                <TextBlock FontFamily="Consolas" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#E65100"
                                           TextWrapping="Wrap">
                                    <Run Text="["/>
                                    <Run Text="{Binding SelectionStart}"/>
                                    <Run Text="-"/>
                                    <Run Text="{Binding SelectionEnd}"/>
                                    <Run Text="] "/>
                                    <Run Text="{Binding SelectedHex}"/>
                                </TextBlock>
                            </Border>
                            <TextBox Grid.Row="1" Text="{Binding SelectedInfo}"
                                     FontFamily="Consolas" FontSize="12"
                                     IsReadOnly="True" Background="#FFFDE7"
                                     BorderThickness="1" BorderBrush="#FFE0B2"
                                     TextWrapping="Wrap" Margin="0,6,0,0" Padding="6"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                        <!-- 无选区时提示（通过 Style 控制，避免本地值覆盖触发器） -->
                        <TextBlock Foreground="#AAA" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="点击设起点"/>
                            <LineBreak/>
                            <Run Text="Shift+点击设终点"/>
                            <LineBreak/>
                            <Run Text="解析结果显示在此"/>
                        </TextBlock>
                    </Grid>
                </GroupBox>
            </Grid>

        </Grid>
    </DockPanel>
</Window>